APP_NAME=Madingo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://mading.test
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Basis data -------------------------------------------------------------
# Aplikasi berjalan dengan peran non-superuser (DB_USERNAME) agar Row-Level
# Security PostgreSQL aktif. Peran ini dibuat otomatis oleh
# `php artisan madingo:install` memakai akun pemilik (DB_OWNER_*).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=madingo
DB_USERNAME=madingo_app
DB_PASSWORD=ganti_sandi_app

DB_OWNER_USERNAME=postgres
DB_OWNER_PASSWORD=admin

# --- Tenant (sekolah) -------------------------------------------------------
# single : satu sekolah, dipilih dari TENANT_DEFAULT_SLUG (tahap sekarang)
# domain : sekolah ditentukan dari domain kustom (tabel school_domains)
#          atau subdomain dari TENANT_BASE_DOMAIN (tahap go public)
TENANT_MODE=single
TENANT_DEFAULT_SLUG=smpn1wajak
TENANT_DEFAULT_NAME="SMP Negeri 1 Wajak"
TENANT_DEFAULT_NPSN=
TENANT_BASE_DOMAIN=madingo.id

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Real-time (Fase 2): `reverb` setelah server Reverb berjalan (lihat docs/DEPLOY-aapanel.md).
# `log` = tanpa WebSocket; kuis live tetap jalan dengan pengecekan berkala.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync = dijalankan langsung (cocok untuk XAMPP). Produksi: database atau redis
# lalu jalankan `php artisan queue:work` lewat Supervisor.
QUEUE_CONNECTION=sync

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@madingo.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Masa berlaku "tetap masuk" (hari)
AUTH_REMEMBER_DAYS=30
# Zona waktu sesi database (bawaan = APP_TIMEZONE)
# DB_TIMEZONE=Asia/Jakarta

# --- Reverb (WebSocket) ------------------------------------------------------
# Buat nilai acak: php artisan tinker --execute="echo Str::random(20);"
REVERB_APP_ID=madingo
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Alamat yang dipakai Laravel untuk mengirim siaran ke Reverb (di server yang sama)
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Proses Reverb mendengarkan di sini (Supervisor: php artisan reverb:start)
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
# Alamat yang dibuka peramban siswa (lewat proxy HTTPS domain sekolah)
REVERB_CLIENT_HOST=
REVERB_CLIENT_PORT=443
REVERB_CLIENT_SCHEME=https
REVERB_ALLOWED_ORIGINS=*
QUIZ_MAX_GUESTS=300
